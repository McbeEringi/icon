{
	"$schema":"node_modules/wrangler/config-schema.json",
	"name":"icon",
	"compatibility_date":"2026-04-30",
	"build":{
		"command":"bun build.mjs",
		"watch_dir":["src","build.mjs"]
	},
	"routes": [
		{"pattern":"6ca.me/img/icon*","zone_name":"6ca.me"},
		{"pattern":"mcbeeringi.dev/img/icon*","zone_name":"mcbeeringi.dev"},
		{"pattern":"www.6ca.me/img/icon*","zone_name":"6ca.me"},
		{"pattern":"www.mcbeeringi.dev/img/icon*","zone_name":"mcbeeringi.dev"}
	],

	"assets":{
		"directory":"./dst",
		"not_found_handling":"404-page"
	}
}
